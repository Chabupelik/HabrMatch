# ==========================================
# HabrSwipe Environment Configuration Template
# ==========================================

# Application
PROJECT_NAME="HabrSwipe API"
DEBUG=True

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=habr_swipe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Security & Telegram Bot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE
# ОБЯЗАТЕЛЬНО: замените на случайную строку, например: openssl rand -hex 32
INTERNAL_API_KEY=REPLACE_WITH_YOUR_SECRET_KEY_openssl_rand_hex_32

# Habr Career Integration
# Сессионная кука habr.com (_habr_career_session или полная строка Cookie)
HABR_SESSION_COOKIE=